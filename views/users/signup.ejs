<% layout("layouts/Boilerplate") -%>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <H3>SIGN UP ON WANDERLUST</H3>
          <form action="signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
            <label for="username" class="form-label" >Username:</label>
            <input name="username" type="text" id="username" class="form-control"  placeholder="Enter a username" required><br><br>
            <div class="valid-feedback">
                Looks good!
            </div>
        </div>
        <div class="mb-3">
            <label for="email" class="form-label" >Email:</label>
            <input name="email" type="email" id="email" class="form-control"  placeholder="Enter your email" required><br><br>
            <div class="valid-feedback">
                Looks good!
            </div>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label" >Password:</label>
            <input name="password" type="password" id="password" class="form-control"  placeholder="Enter a password" required><br><br>
            <div class="valid-feedback">
                Looks good!
            </div>
        </div>
       <button  type="submit" class="btn btn-success mt-2">Sign Up</button>
        </form>
    </div>
</div>