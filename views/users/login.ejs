<% layout("layouts/Boilerplate") -%>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <H3 style="text-align:center " style="color: #007bff;">LOGIN IN ON WANDERLUST</H3>
          <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
            <label for="username" class="form-label" >Username:</label>
            <input name="username" type="text" id="username" class="form-control"  placeholder="Enter a username" required><br><br>
            <div class="valid-feedback">
                Looks good!
            </div>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label" >Password:</label>
            <input name="password" type="password" id="password" class="form-control"  placeholder="Enter a password" required><br><br>
        </div>
       <button  type="submit" class="btn btn-success mt-2">login</button>
        </form>
    </div>
</div>