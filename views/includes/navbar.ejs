<style>
  .navbar{
    height:5rem;
    background:white;
  }

  .fa-compass{
    color:#ff385c;
    font-size:2rem;
  }

  .navbar-brand{
    margin-right:2rem;
  }

  .search-form{
    width:100%;
    display:flex;
    justify-content:center;
  }

  .search-input{
    border-radius:25px 0 0 25px !important;
    padding:0.6rem 1rem;
    width:22rem;
    border:1px solid #ddd;
    border-right:none;
    box-shadow:none !important;
  }

  .search-input:focus{
    border-color:#ddd;
  }

  .btn-search{
    background:#ff385c !important;
    color:white !important;
    border:1px solid #ff385c !important;
    border-radius:0 25px 25px 0 !important;
    padding:0.6rem 1rem;
  }

  .btn-search:hover{
    background:#e31c5f !important;
  }

  .btn-search i{
    margin-right:0.5rem;
  }

  @media(max-width:768px){
    .search-form{
      margin:1rem 0;
    }

    .search-input{
      width:100%;
    }
  }
</style>

<nav class="navbar navbar-expand-lg border-bottom sticky-top">
  <div class="container-fluid">

    <!-- Left -->
    <a class="navbar-brand d-flex align-items-center" href="/listings">
      <i class="fa-regular fa-compass"></i>
      <span class="ms-2 fw-medium">Explore</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
      data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">

      <!-- Center Search -->
      <div class="search-form">
        <form class="d-flex" method="GET" action="/listings">
          <input
            class="form-control search-input"
            type="search"
            name="q"
            placeholder="Search destinations"
            value="<%= typeof search !== 'undefined' ? search : '' %>"
          >

          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search
          </button>
        </form>
      </div>

      <!-- Right -->
      <div class="navbar-nav ms-auto align-items-center">
        <a class="nav-link" href="/listings/new">Airbnb your Home</a>

        <% if(!currUser){ %>
          <a class="nav-link fw-bold" href="/signup">Sign Up</a>
          <a class="nav-link fw-bold" href="/login">Log In</a>
        <% } else { %>
          <a class="nav-link" href="/logout">Log Out</a>
        <% } %>
      </div>

    </div>
  </div>
</nav>