<% layout("layouts/Boilerplate") -%>
<div class="row mt-3">
    <div class="col-6 offset-3">
        <h3>Create New Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label" >Title:</label>
            <input type="text" id="title" class="form-control" name="listing[title]"  placeholder="Enter a catchy title" required>
            <div class="valid-feedback">
                Looks good!
            </div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description:</label>
            <textarea id="description" class="form-control" name="listing[description]"   placeholder="Enter about the place" required></textarea>
        </div>

        <div class="mb-3">
            <label for="image" class="form-label">UPLOAD IMAGE</label>
            <input type="file"  class="form-control" name="listing[image]" >
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" clazss="form-label">Price:</label>
                <input  id="price" class="form-control" name="listing[price]"  placeholder="1200"  required>
                <div class="invalid-feedback">
                    Please enter a valid price.
                </div>
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country:</label>
                <input type="text" id="country" class="form-control" name="listing[country]" placeholder="India"  required>
                <div class="invalid-feedback">
                    Please enter a valid country.
                </div>
            </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location:</label>
            <input type="text" id="location" class="form-control" name="listing[location]"  style="border:solid"  required>
            <div class="invalid-feedback">
                Please enter a valid location.
            </div>
        </div>

        <button type="submit" class="btn btn-dark add-btn mt-2">Create Listing</button>
        </form>
        <br>
        <br>
    </div>
</div>
